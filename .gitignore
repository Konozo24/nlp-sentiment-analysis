# ignore virtual environments
venv/
.env

# ignore scraped data and twscrape session DB
data/raw/*.csv
data/accounts.db

# trained model artifacts ARE tracked so teammates don't have to retrain —
# except the ~500MB RoBERTa checkpoints, which exceed GitHub's 100MB per-file
# limit. They are split into <100MB parts by scripts/checkpoint_parts.py; run
# `python -m scripts.checkpoint_parts restore` after cloning to rebuild them.
data/models/robertacnn/best_model.pt
data/models/robertabase/best_model.pt

# ignore regenerable outputs (rebuild via base_cleaning);
# merged_tweets.csv is NOT ignored — it holds hand-verified sentiment labels
data/processed/cleaned_tweets.csv

# ignore Python cache
__pycache__/
*.pyc
# embedding artifacts: the four files bilstm/predict.py loads at INFERENCE
# (vocab.json, embeddings.npy, indomain_ft.model + its .npy sidecar) ARE
# tracked — without them a fresh clone can't run the BiLSTM at all, and an
# untracked vocab.json is free to drift out of sync with the data the metrics
# were computed on. Ignored below: the 7.2GB fastText download and the
# build-time intermediates, all regenerable via scripts/build_embeddings.py.
data/embeddings/cc.en.300.bin
data/embeddings/corpus.json
data/embeddings/indomain.npy
data/embeddings/pretrained.npy
